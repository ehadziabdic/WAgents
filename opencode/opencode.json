{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "provider": {
    "vercel": {
      "options": {
        "apiKey": "PUT-YOUR-KEY-HERE"
      }
    }
  },
  "plugins": [
    "opencode-mem@latest"
  ],
  "warming": true,
  "disabled_providers": [
    "kilo",
    "vercel",
    "unorouter",
    "omniroute",
    "google",
    "github-copilot"
  ]
  
}
