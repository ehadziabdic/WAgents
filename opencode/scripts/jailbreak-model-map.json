{
  "_comment": "Fallback alias table for ~/.config/opencode/jailbreaks. The keyword matcher runs first and reads filenames directly, so new model files need no entry here. Patterns are .NET regexes matched against the normalized model id and the provider-model string; they exist only for irregular filenames (sonnet, opus, muses) and genuine keyword ties (glm-5.3 vs glm5-3opencode vs glm-zcode-5.3). First match wins.",
  "aliases": [
    { "pattern": "big-?pickle", "file": "BigPickle-opencode.md", "label": "Big Pickle" },
    { "pattern": "space-?bunny", "file": "spacebunny-agents.md", "label": "Space Bunny" },
    { "pattern": "longcat", "file": "longcat-agents.md", "label": "LongCat 2.5" },
    { "pattern": "mimo", "file": "mimo-2.6-agents.md", "label": "MiMo V2.6" },
    { "pattern": "step-?5", "file": "Step-5-preview.md", "label": "Step 5 Preview" },

    { "pattern": "muse.*spark.*1[.-]?3.*v-?2", "file": "Muse-spark-1-3-v2.md", "label": "Muse Spark 1.3 v2" },
    { "pattern": "muse.*spark.*1[.-]?3", "file": "Muse spark 1.3.md", "label": "Muse Spark 1.3" },
    { "pattern": "muse.*wonder", "file": "Muse-wonder.md", "label": "Muse Wonder" },
    { "pattern": "muse.*(ai|chat|instruct)", "file": "muse-ai-AGENTS.md", "label": "Muse.ai" },

    { "pattern": "deepseek.*4[.-]?1", "file": "deepseek-4-1.md", "label": "DeepSeek 4.1" },
    { "pattern": "deepseek.*v-?4", "file": "deepseek v4.md", "label": "DeepSeek V4" },
    { "pattern": "deepseek.*v-?3", "file": "deepseek v3.md", "label": "DeepSeek V3" },

    { "pattern": "zcode.*glm.*5[.-]?3.*agents|glm.*zcode.*5[.-]?3.*agents", "file": "glm-zcode-5.3-AGENTS.md", "label": "GLM ZCode 5.3 (AGENTS)" },
    { "pattern": "zcode.*glm.*5[.-]?3|glm.*zcode.*5[.-]?3", "file": "glm-zcode-5.3.md", "label": "GLM ZCode 5.3" },
    { "pattern": "zcode.*glm.*5[.-]?2|glm.*zcode.*5[.-]?2", "file": "glm-zcode-5.2.md", "label": "GLM ZCode 5.2" },
    { "pattern": "glm.*5[.-]?3.*flash", "file": "glm-5-3-flash.md", "label": "GLM-5.3 Flash" },
    { "pattern": "glm.*5[.-]?3", "file": "glm5-3opencode.md", "label": "GLM-5.3 (OpenCode)" },
    { "pattern": "glm.*5[.-]?2", "file": "glm-5.2.md", "label": "GLM-5.2" },

    { "pattern": "gemini.*4.*argon", "file": "Gemini-4-Argon.md", "label": "Gemini 4 Argon" },
    { "pattern": "gemini.*3[.-]?1.*pro", "file": "gemini-3.1-pro.md", "label": "Gemini 3.1 Pro" },
    { "pattern": "gemma.*4", "file": "gemma4.md", "label": "Gemma 4" },
    { "pattern": "gpt.*oss.*20", "file": "gpt-oss-20b.md", "label": "GPT-OSS 20B" },

    { "pattern": "grok.*build", "file": "Grok build.md", "label": "Grok Build" },
    { "pattern": "grok.*4[.-]?7", "file": "grok-4.7.md", "label": "Grok 4.7" },

    { "pattern": "kimi.*k?3[.-]?1", "file": "kimik3.1.md", "label": "Kimi K3.1" },
    { "pattern": "kimi.*k?3", "file": "kimi-k3-agents.md", "label": "Kimi K3" },
    { "pattern": "kimi.*k?2", "file": "kimi-k2.md", "label": "Kimi K2" },

    { "pattern": "mistral.*large.*4|mistral.*4", "file": "Mistral-Large-4.md", "label": "Mistral Large 4" },
    { "pattern": "nemotron.*3.*ultra|nemotron.*ultra", "file": "nemotron-3-ultra.md", "label": "Nemotron 3 Ultra" },

    { "pattern": "opus.*v-?2", "file": "opus v2.md", "label": "Opus v2" },
    { "pattern": "opus", "file": "opus v1.md", "label": "Opus v1" },
    { "pattern": "sonnet.*v-?2", "file": "Sonnet v2.md", "label": "Sonnet v2" },
    { "pattern": "sonnet", "file": "sonnet v1.md", "label": "Sonnet v1" },

    { "pattern": "qwen.*3[.-]?8", "file": "qwen-3.8.md", "label": "Qwen 3.8" },
    { "pattern": "qwen.*3[.-]?7", "file": "qwen-3.7.md", "label": "Qwen 3.7" },

    { "pattern": "beam", "file": "Beam.md", "label": "Beam" },
