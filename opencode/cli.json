{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "dracula"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": true,
    "permissions": "autoaccept",
    "verbosity": "medium",
    "new_location": "launch"
  },
  "tabs": {
    "mode": "on",
    "layout": "horizontal",
    "indicators": "status",
    "scope": "global"
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "tree": true,
    "single": true
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "leader": {
    "timeout": 2000
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.7999999999999999
  },
  "terminal": {
    "copy": "manual",
    "title": false
  },
  "debug": {
    "devtools": true,
    "timing": false,
    "turn_tokens": "verbose"
  },
  "scroll": {
    "acceleration": true
  }
}
