{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "C:\\Users\\eminha\\.config\\opencode\\skills"
    ]
  },
  "mcp": {
    "timeout": {
      "startup": 60000,
      "catalog": 30000
    },
    "servers": {
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com",
        "disabled": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "PUT-YOUR-TOKEN-HERE"
        }
      },
      "scrapling": {
        "type": "local",
        "command": [
          "C:\\Users\\eminha\\AppData\\Local\\Programs\\Python\\Python313\\Scripts\\scrapling.exe",
          "mcp"
        ]
      },
      "codebase-memory": {
        "type": "local",
        "command": [
          "codebase-memory-mcp"
        ],
        "environment": {
          "CBM_RUNTIME_DIR": "C:\\Users\\eminha\\cbm-runtime"
        }
      },
      "iris": {
        "type": "local",
        "command": [
          "C:\\Users\\eminha\\.cargo\\bin\\iris.exe",
          "mcp",
          "--chrome",
          "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
        ]
      }
    }
  },
  "disabled_providers": [],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" }
  ],
  "provider": {
    "omniroute": {
      "name": "Omni Route",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "openrouter/nex-agi/nex-n2.5-pro:free": {
          "name": "Nex N2.5 Pro"
        }
      }
    }
  },
  "instructions": [
    "instructions/wagents-global.md",
    "instructions/wagents-documentation.md",
    "instructions/wagents-python.md",
    "instructions/wagents-react.md",
    "instructions/wagents-security.md",
    "instructions/wagents-testing.md",
    "instructions/wagents-typescript.md"
  ],
  "plugin": []
}
