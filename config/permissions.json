{
  "version": "1.0.0",
  "model": "least-privilege per agent; no wildcard full-access unless explicitly enabled",
  "agents": {
    "wagent": {
      "tools": [
        "read",
        "edit",
        "search",
        "github-read",
        "context7",
        "playwright"
      ],
      "mcp": [
        "github",
        "context7",
        "codebase-memory",
        "notion-read",
        "agentmemory"
      ],
      "note": "Merged orchestrator+architect. Owns codebase-memory indexing. Notion is read-only by default; knowledge-base writes require explicit confirmation. Must not delegate to wagent-hacker.",
      "may_delegate_to": [
        "frontend-designer",
        "backend-engineer",
        "security-engineer",
        "code-reviewer",
        "debugger",
        "qa-engineer",
        "research-specialist",
        "documentation-specialist",
        "ml-engineer",
        "devops-engineer"
      ],
      "must_not_call": [
        "wagent-hacker"
      ]
    },
    "wagent-hacker": {
