{
  "description": "WAgents lifecycle automation hooks (ours + vendored agentmemory auto-capture hooks)",
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start.sh"
      },
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/session-start.mjs\""
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/prompt-submit.mjs\""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read|Glob|Grep",
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/pre-tool-use.mjs\""
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/post-tool-use.mjs\""
      }
    ],
    "PostToolUseFailure": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/post-tool-failure.mjs\""
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/pre-compact.mjs\""
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/subagent-start.mjs\""
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/subagent-stop.mjs\""
      }
    ],
    "Notification": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/notification.mjs\""
      }
    ],
    "TaskCompleted": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/task-completed.mjs\""
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/stop.mjs\""
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agentmemory/session-end.mjs\""
      }
    ]
  }
}

