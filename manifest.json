{
  "name": "wagents",
  "version": "0.3.0",
  "description": "Portable, reproducible personal Agent OS for GitHub Copilot / Copilot CLI / VS Code. wagent (main; orchestrator+architect merged) + wagent-hacker (authorized offensive mode) + 10 specialists.",
