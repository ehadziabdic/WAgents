#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cmd="${1:-help}"
case "$cmd" in
  init)
    echo "[wagents][error] init is not implemented; no project files were created." >&2
    echo "  See $ROOT/docs/architecture.md for project configuration guidance." >&2
    exit 1
    ;;
  install)
    shift || true
    bash "$ROOT/install.sh" "$@"
    ;;
  update)
    bash "$ROOT/scripts/update.sh"
    ;;
  doctor)
    bash "$ROOT/scripts/doctor.sh"
    ;;
  list)
    echo "[wagents] agents:"
    cat "$ROOT/config/agents.json" | python3 -c "import json,sys; [print(' - '+a['id']) for a in json.load(open(sys.argv[1]))['agents']]" "$ROOT/config/agents.json"
    echo "[wagents] skills:"
    cat "$ROOT/config/skills.json" | python3 -c "import json,sys; [print(' - '+s['name']+' ('+s['status']+')') for s in json.load(open(sys.argv[1]))['skills']]" "$ROOT/config/skills.json"
    ;;
  install-security|install-ml|install-frontend)
    echo "[wagents] $cmd: selective install not yet needed — all core agents ship by default."
    echo "  Optional third-party skills: see docs/skills.md and .github/skills/_third-party/README.md"
    ;;
  help|*)
    echo "Usage: wagents <init|install|update|doctor|list|install-security|install-ml|install-frontend>"
    ;;
esac
